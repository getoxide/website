{
  "name": "oxide-website",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./out",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  // Workers Builds runs `npx wrangler preview` for every PR build; the
  // command fails without a `previews` block, even an empty one.
  "previews": {},
}
